module Main
fn main() do
  with {:ok, buffer} <- read_all(IO.stdin(), Buffer.new()),
      {:ok, text} <- String.from_bytes(Buffer.to_bytes(buffer)),
      {:ok, formatted} <- Pretty.format(text) do
    IO.println(formatted)
  else
    utf8_error: {:error, String.Utf8Error} ->
      IO.report("error: input is not valid UTF-8")
    {:error, error} ->
      IO.report(error)
  end
end

fn read_all(reader: IO.Stdin, buffer: Buffer) -> {:ok, Buffer} | {:error, IO.Error} do
  match Reader.read(reader, 4096) do
    {:ok, data} ->
      read_all(reader, Buffer.append_bytes(buffer, data))
    :eof ->
      {:ok, buffer}
    {:error, error} ->
      {:error, error}
  end
end
